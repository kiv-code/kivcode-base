{
  "name": "@kivcode/base",
  "version": "1.2.0",
  "description": "Infraestructura compartida de los sitios del estudio KivCode. Sin diseño: el diseño es de cada cliente.",
  "type": "module",
  "license": "MIT",
  "exports": {
    "./worker": "./src/worker/index.mjs",
    "./schemas/site": "./src/schemas/site.ts",
    "./schemas/content": "./src/schemas/content.ts",
    "./content": "./src/content/filters.ts",
    "./forms": "./src/forms/contact.ts",
    "./icons": "./src/icons/registry.ts",
    "./styles/base.css": "./src/styles/base.css",
    "./tsconfig": "./tsconfig.json",
    "./prettier": "./prettier.json",
    "./astro": "./src/integrations/config.mjs",
    "./integrations/headers": "./src/integrations/headers.mjs",
    "./routes/robots": "./src/routes/robots.ts"
  },
  "bin": {
    "kivcode-check-theme": "./bin/check-theme.mjs"
  },
  "files": [
    "src",
    "bin",
    "templates",
    "tsconfig.json",
    "prettier.json"
  ],
  "peerDependencies": {
    "astro": ">=7",
    "@astrojs/sitemap": ">=3",
    "@tailwindcss/vite": ">=4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
