# Variables PÚBLICAS de compilación. Se incrustan en el HTML: nada secreto acá.
# Se versiona este archivo, no el `.env`.

# Dominio canónico. Sin definir, astro.config.mjs usa el de por defecto.
# Cambiarlo EXIGE recompilar, o el canonical y el sitemap quedan viejos.
PUBLIC_SITE_URL=

# Clave pública de Cloudflare Turnstile. Es pública: va al HTML.
# La clave secreta NUNCA vive acá, va en `wrangler secret put`.
PUBLIC_TURNSTILE_SITE_KEY=
